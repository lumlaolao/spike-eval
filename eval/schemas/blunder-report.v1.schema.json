{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blunder-report.v1",
  "title": "Adjudicated decision line of a blunder report (one jsonl line) — see eval/EVAL-DESIGN.md §4 / §10.2",
  "type": "object",
  "required": ["schema", "run_dir", "game_file", "decision_index", "seat", "model", "turn", "decision_type", "n_options", "choice", "flag_lane", "adjudication"],
  "properties": {
    "schema": {"const": "blunder-report.v1"},
    "run_dir": {"type": "string"},
    "game_file": {"type": "string"},
    "decision_index": {"type": "integer", "minimum": 0},
    "seat": {"type": "string"},
    "model": {"type": "string", "description": "backend:model spec or local:tag"},
    "turn": {"type": "integer"},
    "decision_type": {"type": "string"},
    "n_options": {"type": "integer", "minimum": 2},
    "choice": {"type": "integer", "description": "0-based; -1 = PASS/decline sentinel (harness convention)"},
    "flag_lane": {"enum": ["shadow-disagree", "text-flag", "audit-sample"]},
    "flags": {"type": "array", "items": {"type": "string"}},
    "shadow_choice": {"type": ["integer", "null"]},
    "adjudication": {
      "type": "object",
      "required": ["method", "class"],
      "properties": {
        "method": {"enum": ["rollout", "exhaustive", "textlane-verified", "unadjudicable"]},
        "n_per_option": {"type": "integer"},
        "wp_chosen": {"type": "number", "minimum": 0, "maximum": 1},
        "wp_best": {"type": "number", "minimum": 0, "maximum": 1},
        "wpl": {"type": "number", "minimum": 0, "description": "win-probability loss = wp_best - wp_chosen"},
        "wpl_se": {"type": "number", "minimum": 0},
        "class": {"enum": ["good", "inaccuracy", "mistake", "blunder", "unadjudicable"]},
        "caveats": {"type": "array", "items": {"enum": ["rollout_policy_caveat", "single_deal_hidden_info"]}}
      }
    }
  }
}
