# build artifacts / local
/tmp/
*.class
target/
.DS_Store

# recorded match video: large binaries, NOT committed like the JSONL eval data.
# Archive mp4s out-of-band (upload/social) rather than into git history.
*.mp4
*.mp4.ffmpeg.log

# local OpenRouter credentials — never commit the real key (template is secrets.env.example)
secrets.env
# where setup.sh put Forge (play-vs-llm.sh reads it)
.forge-home

# MLX fine-tuning: local venv, downloaded base models + LoRA adapters, staged data dir
.venv-mlx/
models/
datasets/stage1-v0-mlx/

# Every game, batch, acceptance and puzzle run writes here: full model transcripts and logs, hundreds of MB.
# They are run outputs, not source; the docs name the run a number came from.
runs/

# Puzzle harvest: raw fetched API dumps are regenerable (harvest.py); keep only the curated
# corpus, the normalized inputs and the tool.
eval/puzzles/modern/raw/api/
eval/puzzles/modern/raw/items/rulesguru.jsonl

# Claude Code: agent and skill definitions under .claude/ ARE tracked (docs/STANDARDS.md);
# per-machine settings and worktrees are not.
.claude/settings.local.json
.claude/worktrees/

__pycache__/
*.py[co]
.pytest_cache/
.venv/
*.swp

# Wizards of the Coast text, downloaded by eval/fetch_comp_rules.py (setup.sh, acceptance preflight).
data/rules/MagicCompRules.txt

# Local environment and editor files.
.env
.env.*
.idea/
.vscode/
