# build artifacts / local
/tmp/
*.class
target/
.DS_Store

# recorded match video: large binaries, NOT committed like the JSONL eval data.
# Archive mp4s out-of-band (upload/social) rather than into git history.
*.mp4
*.mp4.ffmpeg.log

# local OpenRouter credentials — never commit the real key (template is secrets.env.example)
secrets.env

# MLX fine-tuning: local venv, downloaded base models + LoRA adapters, staged data dir
.venv-mlx/
models/
datasets/stage1-v0-mlx/

# D1 self-play corpus (~5,400 games): large generated JSONL/logs, never swept into git history.
runs/d1-selfplay/

# cloud dashboard runtime state: personal cost ledger + per-job local config
cloud/aws_ledger.jsonl
cloud/dashboard_config.json

# Runpod job artifacts: the shipped dataset tarball (~50MB) and the returned adapter
# (~200-600MB). Same reasoning as d1-selfplay — regenerable from the dataset dir +
# config, so it is a build artifact, not history. MANIFEST.txt IS kept: it is the
# provenance record (row counts, sha256s, harness commit) that makes a cloud run
# traceable, and it is a few hundred bytes.
runs/runpod/*/job.tar.gz
runs/runpod/*/adapter.tar.gz
runs/runpod/*/out/
runs/runpod/*/pod.env
runs/runpod/*/POD_ID
runs/runpod/*/job.tar.gz.tmp
runs/runpod/*/bootstrap.log

# verify_keys rollout scratch: thousands of transient per-game jsonl files
# written DURING a run. Never an artifact -- `git add -A` mid-run swept 10,208
# of them (3.2M lines) into a docs commit.
runs/**/verify-keys-work/

# Large regenerable eval-run data (candidate mining, overnight rollouts, floor
# sweeps, PZL per-puzzle JVM logs). These are gigabytes of transient output that
# are re-produced on demand by the pipeline (mine -> verify -> suite). The small
# frozen SUITES and the results.jsonl/summary.json summaries ARE kept when a run
# is citable; the bulk per-puzzle logs and candidate dumps are not history.
runs/mine-round-*/
runs/overnight-*/
runs/str-floors/
runs/pzl/

# transient infra state: which AMI the last bake produced (re-derivable from the bake log)
cloud/bench/.last-ami
